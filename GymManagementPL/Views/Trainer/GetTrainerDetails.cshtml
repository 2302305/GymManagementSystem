@using GymManagementBLL.ViewModels.TrainerViewModel
@model TrainerDetailsViewModel
@{
    ViewData["Title"] = "Trainer Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow">
                <div class="card-header bg-primary-color text-white text-center py-5">
                    <i class="bi bi-person-badge" style="font-size:3rem;display:block;margin-bottom:12px;"></i>
                    <h2 class="mb-1 fw-bold">@Model.Name</h2>
                    <span class="badge rounded-pill mt-1" style="background:rgba(255,255,255,.2);padding:6px 16px;font-size:.8rem;">
                        @Model.Specialization Trainer
                    </span>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex align-items-center gap-3 p-3 rounded" style="background:var(--surface);border:1px solid var(--border);">
                            <div style="width:42px;height:42px;border-radius:8px;background:var(--accent-light);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i class="bi bi-envelope" style="color:var(--primary);"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block" style="font-size:.73rem;text-transform:uppercase;letter-spacing:.5px;">Email</small>
                                <strong>@Model.Email</strong>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3 p-3 rounded" style="background:var(--surface);border:1px solid var(--border);">
                            <div style="width:42px;height:42px;border-radius:8px;background:var(--accent-light);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i class="bi bi-telephone" style="color:var(--primary);"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block" style="font-size:.73rem;text-transform:uppercase;letter-spacing:.5px;">Phone</small>
                                <strong>@Model.Phone</strong>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3 p-3 rounded" style="background:var(--surface);border:1px solid var(--border);">
                            <div style="width:42px;height:42px;border-radius:8px;background:var(--accent-light);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i class="bi bi-calendar-date" style="color:var(--primary);"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block" style="font-size:.73rem;text-transform:uppercase;letter-spacing:.5px;">Date of Birth</small>
                                <strong>@Model.DateOfBirth</strong>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3 p-3 rounded" style="background:var(--surface);border:1px solid var(--border);">
                            <div style="width:42px;height:42px;border-radius:8px;background:var(--accent-light);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i class="bi bi-geo-alt" style="color:var(--primary);"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block" style="font-size:.73rem;text-transform:uppercase;letter-spacing:.5px;">Address</small>
                                <strong>@Model.BuildingNumber – @Model.Street – @Model.City</strong>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <a asp-controller="Trainer" asp-action="Index"
                       class="btn-outline d-flex align-items-center gap-2 justify-content-center">
                        <i class="bi bi-arrow-left"></i>Back to Trainers
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>