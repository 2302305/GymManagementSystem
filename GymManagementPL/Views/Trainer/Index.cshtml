@using GymManagementBLL.ViewModels.TrainerViewModel
@model IEnumerable<TrainersViewModel>
@{
    ViewData["Title"] = "Trainers";
}

@if (TempData["SuccessMessage"] is not null)
{
    <div id="Alert" class="alert alert-success alert-dismissible fade show mt-3">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] is not null)
{
    <div id="Alert" class="alert alert-danger alert-dismissible fade show mt-3">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container">
    <div class="page-header">
        <div>
            <h2><i class="bi bi-person-badge me-2"></i>Trainers</h2>
            <p>Professional fitness instructors</p>
        </div>
        <a asp-controller="Trainer" asp-action="Create"
           class="btn-fill d-flex align-items-center gap-2 rounded-pill" style="padding:10px 22px;">
            <i class="bi bi-plus-lg"></i>Add Trainer
        </a>
    </div>

    @if (Model is not null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-borderless">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Speciality</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var trainer in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:36px;height:36px;border-radius:50%;background:var(--accent-light);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                        <i class="bi bi-person-fill" style="color:var(--primary);"></i>
                                    </div>
                                    <strong>@trainer.Name</strong>
                                </div>
                            </td>
                            <td>@trainer.Email</td>
                            <td>@trainer.Phone</td>
                            <td>
                                <span class="badge rounded-pill"
                                      style="background:var(--accent-light);color:var(--primary);font-weight:600;padding:5px 12px;">
                                    @trainer.Specialities.ToString()
                                </span>
                            </td>
                            <td class="action position-relative">
                                <div class="dropdown">
                                    <!-- Change this button -->
                                    <button class="btn btn-link p-0 border-0 d-flex align-items-center" type="button"
                                            id="ddBtn-@trainer.Id" data-dd-toggle>
                                        <!-- ADD THIS -->
                                        <i class="bi bi-three-dots-vertical" style="font-size:1.1rem;color:var(--text-muted);"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="ddBtn-@trainer.Id">
                                        <li>
                                            <a asp-action="GetTrainerDetails" asp-controller="Trainer" asp-route-id="@trainer.Id" class="dropdown-item">
                                                <i class="bi bi-eye me-2 text-primary-color"></i>View Details
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a asp-controller="Trainer" asp-action="Edit" asp-route-id="@trainer.Id" class="dropdown-item">
                                                <i class="bi bi-pencil me-2 text-primary-color"></i>Edit Details
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a asp-action="Delete" asp-controller="Trainer" asp-route-id="@trainer.Id" class="dropdown-item text-danger">
                                                <i class="bi bi-trash me-2"></i>Delete
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-person-workspace"></i>
            <h4>No Trainers Yet</h4>
            <p>Add your first trainer to get started.</p>
        </div>
    }
</div>

@section Scripts {
    <partial name="_AlertTimeOut" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Store button->menu pairs BEFORE moving anything
            const pairs = [];
            document.querySelectorAll('[data-dd-toggle]').forEach(function (btn) {
                const menu = btn.nextElementSibling;
                if (menu && menu.classList.contains('dropdown-menu')) {
                    document.body.appendChild(menu);
                    pairs.push({ btn, menu });
                }
            });

            pairs.forEach(function ({ btn, menu }) {
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    const isOpen = menu.classList.contains('show');

                    // Close all first
                    pairs.forEach(p => p.menu.classList.remove('show'));

                    if (!isOpen) {
                        const rect = btn.getBoundingClientRect();
                        menu.style.position = 'fixed';
                        menu.style.zIndex   = '9999';
                        menu.style.top      = (rect.bottom + 4) + 'px';
                        menu.style.left     = 'auto';
                        menu.style.right    = (window.innerWidth - rect.right) + 'px';
                        menu.classList.add('show');
                    }
                });
            });

            document.addEventListener('click', function () {
                pairs.forEach(p => p.menu.classList.remove('show'));
            });
        });
    </script>
}