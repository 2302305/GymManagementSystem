@{
    ViewData["Title"] = "Delete Trainer";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow text-center" style="border-top:4px solid var(--danger);border-radius:12px;">
                <div class="card-body p-5">
                    <i class="bi bi-person-badge mb-3" style="color:var(--danger);font-size:3.5rem;display:block;"></i>
                    <h3 class="fw-bold mb-1">@ViewBag.TrainerName</h3>
                    <p class="text-muted mb-4">Are you sure you want to permanently delete this trainer?</p>
                    <div class="alert alert-warning text-start mb-4">
                        <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>Warning</strong><br>
                        <small>This action cannot be undone. All trainer data will be permanently removed.</small>
                    </div>
                    <form asp-action="DeleteConfirm" method="post">
                        <input type="hidden" name="id" value="@ViewBag.TrainerId" />
                        <div class="d-flex gap-3">
                            <a asp-controller="Trainer" asp-action="Index"
                               class="btn-outline flex-fill d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-x-lg"></i>Cancel
                            </a>
                            <button type="submit"
                                    class="btn-fill flex-fill d-flex align-items-center justify-content-center gap-2"
                                    style="background:var(--danger);border-color:var(--danger);">
                                <i class="bi bi-trash"></i>Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>