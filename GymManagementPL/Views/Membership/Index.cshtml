@using GymManagementBLL.ViewModels.MembershipViewModel
@model IEnumerable<MembershipViewModel>
@{
    ViewData["Title"] = "Memberships";
}

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container">
    <div class="page-header">
        <div>
            <h2><i class="bi bi-award me-2"></i>Memberships</h2>
            <p>Manage member plan assignments</p>
        </div>
        <a asp-action="Create" class="btn-fill d-flex align-items-center gap-2 rounded-pill" style="padding:10px 22px;">
            <i class="bi bi-plus-lg"></i>New Membership
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-borderless">
                <thead>
                    <tr>
                        <th>Member</th>
                        <th>Plan</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var membership in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:34px;height:34px;border-radius:50%;background:var(--accent-light);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                        <i class="bi bi-person-fill" style="color:var(--primary);font-size:.9rem;"></i>
                                    </div>
                                    <strong>@membership.MemberName</strong>
                                </div>
                            </td>
                            <td>
                                <span class="badge rounded-pill" style="background:var(--accent-light);color:var(--primary);font-weight:600;padding:5px 12px;">
                                    @membership.PlanName
                                </span>
                            </td>
                            <td><i class="bi bi-calendar-check me-1" style="color:var(--success);"></i>@membership.StartDate.ToString("MMM dd, yyyy")</td>
                            <td><i class="bi bi-calendar-x me-1" style="color:var(--danger);"></i>@membership.EndDate.ToString("MMM dd, yyyy")</td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                        data-bs-toggle="modal" data-bs-target="#cancelModal"
                                        data-member-id="@membership.MemberId"
                                        data-plan-id="@membership.PlanId"
                                        data-member-name="@membership.MemberName"
                                        data-plan-name="@membership.PlanName"
                                        style="font-size:.8rem;font-weight:600;">
                                    <i class="bi bi-ban me-1"></i>Cancel
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-award"></i>
            <h4>No Memberships Yet</h4>
            <p>Assign a plan to a member to get started.</p>
        </div>
    }
</div>

<div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content">
            <div class="modal-header" style="background:var(--danger);color:#fff;">
                <h5 class="modal-title"><i class="bi bi-ban me-2"></i>Cancel Membership</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size:2.5rem;"></i>
                <p class="mt-3 mb-0">Are you sure you want to cancel this membership?</p>
                <div class="p-3 rounded mt-3 text-start" style="background:var(--surface);border:1px solid var(--border);">
                    <div class="mb-1"><strong>Member:</strong> <span id="modalMemberName"></span></div>
                    <div><strong>Plan:</strong> <span id="modalPlanName"></span></div>
                </div>
                <p class="text-danger small mt-3 mb-0"><i class="bi bi-exclamation-triangle-fill me-1"></i>This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-4" data-bs-dismiss="modal">Keep Membership</button>
                <form id="cancelForm" asp-action="Cancel" asp-controller="Membership" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="cancelMemberId" name="memberId" />
                    <input type="hidden" id="cancelPlanId" name="planId" />
                    <button type="submit" class="btn btn-danger btn-sm rounded-pill px-4">
                        <i class="bi bi-ban me-1"></i>Yes, Cancel
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('cancelModal').addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            document.getElementById('modalMemberName').textContent = button.getAttribute('data-member-name');
            document.getElementById('modalPlanName').textContent   = button.getAttribute('data-plan-name');
            document.getElementById('cancelMemberId').value        = button.getAttribute('data-member-id');
            document.getElementById('cancelPlanId').value          = button.getAttribute('data-plan-id');
        });
    </script>
}