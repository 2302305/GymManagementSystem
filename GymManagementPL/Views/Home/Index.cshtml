@using GymManagementBLL.ViewModels.AnalyticsViewModels
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model AnalyticsViewModel
@{
    ViewData["Title"] = "Home";
}

<style>
    /* ─── Design Tokens ─────────────────────────────────────────── */
    :root {
        --primary: #1E3A8A;
        --primary-dark: #172554;
        --primary-glow: rgba(30, 58, 138, 0.18);
        --accent: #3B82F6;
        --accent-light: #60A5FA;
        --bg: #F8FAFC;
        --surface: #FFFFFF;
        --surface-2: #F1F5F9;
        --surface-3: #E2E8F0;
        --text: #0F172A;
        --text-secondary: #334155;
        --muted: #64748B;
        --border: rgba(148, 163, 184, 0.25);
        --radius: 16px;
        --radius-sm: 8px;
        --radius-lg: 24px;
        --transition: cubic-bezier(0.22, 1, 0.36, 1);
        --shadow-sm: 0 1px 2px rgba(0,0,0,0.04);
        --shadow: 0 4px 12px rgba(0,0,0,0.06);
        --shadow-lg: 0 12px 40px rgba(0,0,0,0.08);
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        background: var(--bg);
        color: var(--text);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        overflow-x: hidden;
        line-height: 1.6;
    }

    /* ─── Scroll reveal ─────────────────────────────────────────── */
    .reveal {
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.7s var(--transition), transform 0.7s var(--transition);
    }

        .reveal.visible {
            opacity: 1;
            transform: none;
        }

    .reveal-delay-1 {
        transition-delay: 0.1s;
    }

    .reveal-delay-2 {
        transition-delay: 0.2s;
    }

    .reveal-delay-3 {
        transition-delay: 0.3s;
    }

    /* ─── Ticker ─────────────────────────────────────────────────  */
    .ticker-wrap {
        background: var(--primary);
        overflow: hidden;
        padding: 12px 0;
    }

    .ticker-track {
        display: flex;
        width: max-content;
        animation: ticker 28s linear infinite;
    }

    .ticker-item {
        display: inline-flex;
        align-items: center;
        gap: 16px;
        padding: 0 32px;
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
        color: #fff;
    }

    .ticker-dot {
        width: 6px;
        height: 6px;
        background: rgba(255,255,255,0.55);
        border-radius: 50%;
        flex-shrink: 0;
    }

    @@keyframes ticker {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(-50%);
        }
    }

    /* ─── Hero ───────────────────────────────────────────────────  */
    .hero {
        position: relative;
        min-height: 92vh;
        display: grid;
        grid-template-columns: 1fr 480px;
        align-items: center;
        overflow: hidden;
        padding: 80px 6vw 60px;
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    }

        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
            background-size: 60px 60px;
            pointer-events: none;
            z-index: 0;
        }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 100px;
        padding: 6px 16px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.9);
        margin-bottom: 28px;
        animation: fadeInDown 0.7s var(--transition) both;
    }

    .hero-eyebrow-dot {
        width: 7px;
        height: 7px;
        background: var(--accent-light);
        border-radius: 50%;
        animation: pulse 1.8s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.5;
            transform: scale(0.7);
        }
    }

    .hero-headline {
        font-size: clamp(2.6rem, 5.5vw, 5rem);
        font-weight: 900;
        line-height: 1.04;
        letter-spacing: -0.03em;
        margin-bottom: 28px;
        animation: fadeInUp 0.75s 0.1s var(--transition) both;
        color: #fff;
    }

        .hero-headline .accent {
            color: var(--accent-light);
        }

    .hero-sub {
        color: rgba(255,255,255,0.75);
        font-size: 1.05rem;
        line-height: 1.75;
        max-width: 480px;
        margin-bottom: 44px;
        animation: fadeInUp 0.75s 0.2s var(--transition) both;
    }

    .stats-strip {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: var(--radius);
        overflow: hidden;
        margin-bottom: 44px;
        background: rgba(255,255,255,0.08);
        backdrop-filter: blur(10px);
        animation: fadeInUp 0.75s 0.3s var(--transition) both;
    }

    .stat-cell {
        padding: 20px 24px;
        border-right: 1px solid rgba(255,255,255,0.1);
        transition: background 0.25s;
    }

        .stat-cell:last-child {
            border-right: none;
        }

        .stat-cell:hover {
            background: rgba(255,255,255,0.06);
        }

    .stat-number {
        font-size: 1.9rem;
        font-weight: 800;
        color: #fff;
        line-height: 1;
        display: block;
        margin-bottom: 4px;
    }

        .stat-number.accent {
            color: var(--accent-light);
        }

    .stat-label {
        font-size: 0.72rem;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.6);
    }

    .hero-buttons {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        animation: fadeInUp 0.75s 0.4s var(--transition) both;
    }

    .btn-primary-gym {
        background: #fff;
        color: var(--primary);
        border: none;
        border-radius: 100px;
        padding: 14px 34px;
        font-weight: 700;
        font-size: 0.9rem;
        letter-spacing: 0.04em;
        cursor: pointer;
        transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
    }

        .btn-primary-gym:hover {
            background: var(--surface-2);
            transform: translateY(-2px);
            box-shadow: 0 8px 32px rgba(0,0,0,0.2);
        }

    .btn-outline-gym {
        background: transparent;
        color: #fff;
        border: 1px solid rgba(255,255,255,0.25);
        border-radius: 100px;
        padding: 14px 34px;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s, transform 0.2s;
    }

        .btn-outline-gym:hover {
            border-color: #fff;
            background: rgba(255,255,255,0.1);
            transform: translateY(-2px);
        }

    /* ─── Hero image panel ───────────────────────────────────────  */
    .hero-image-panel {
        position: relative;
        z-index: 2;
        height: 620px;
        animation: fadeInRight 0.9s 0.2s var(--transition) both;
    }

    .hero-img-main {
        position: absolute;
        right: 0;
        bottom: 0;
        width: 420px;
        height: 600px;
        object-fit: cover;
        border-radius: 240px 240px 0 0;
        box-shadow: -24px 0 80px rgba(0,0,0,0.3);
    }

    .hero-glow {
        position: absolute;
        right: 60px;
        bottom: 0;
        width: 340px;
        height: 500px;
        background: radial-gradient(ellipse at bottom, rgba(59,130,246,0.35) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
        z-index: 1;
    }

    .hero-float-card {
        position: absolute;
        left: -20px;
        top: 120px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 16px 20px;
        min-width: 160px;
        z-index: 4;
        animation: floatCard 4s ease-in-out infinite;
        box-shadow: var(--shadow-lg);
    }

    .float-label {
        font-size: 0.7rem;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 6px;
    }

    .float-value {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--primary);
    }

    .float-sub {
        font-size: 0.72rem;
        color: var(--muted);
    }

    @@keyframes floatCard {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    @@keyframes fadeInDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    @@keyframes fadeInRight {
        from {
            opacity: 0;
            transform: translateX(50px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    /* ─── Shared section styles ──────────────────────────────────  */
    .section-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 6vw;
    }

    .section-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.73rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--primary);
        margin-bottom: 14px;
    }

        .section-eyebrow::before {
            content: '';
            display: block;
            width: 28px;
            height: 2px;
            background: var(--primary);
            border-radius: 2px;
        }

    /* ─── About ──────────────────────────────────────────────────  */
    .about-section {
        padding: 100px 0;
        border-top: 1px solid var(--border);
        background: var(--bg);
    }

    .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 80px;
        align-items: center;
    }

    .about-images {
        position: relative;
        height: 520px;
    }

    .about-img {
        position: absolute;
        object-fit: cover;
        border-radius: var(--radius);
        transition: transform 0.4s var(--transition);
    }

    .about-img-1 {
        width: 70%;
        height: 75%;
        top: 0;
        left: 0;
        z-index: 2;
        border-radius: 160px 160px var(--radius) var(--radius);
    }

    .about-img-2 {
        width: 55%;
        height: 52%;
        bottom: 0;
        right: 0;
        z-index: 3;
        border-radius: var(--radius) var(--radius) 120px 120px;
        box-shadow: 0 0 0 6px var(--bg);
    }

    .about-img-3 {
        width: 44%;
        height: 38%;
        bottom: 30px;
        left: 50px;
        z-index: 1;
        filter: brightness(0.5);
    }

    .about-images:hover .about-img-1 {
        transform: scale(1.02) rotate(-1deg);
    }

    .about-images:hover .about-img-2 {
        transform: scale(1.03) rotate(1deg);
    }

    .about-badge {
        position: absolute;
        bottom: 20px;
        left: -16px;
        background: var(--primary);
        color: #fff;
        padding: 16px 22px;
        border-radius: var(--radius);
        z-index: 5;
        box-shadow: 0 16px 40px rgba(30,58,138,0.3);
    }

    .about-badge-num {
        font-size: 2rem;
        font-weight: 900;
        display: block;
        line-height: 1;
    }

    .about-badge-txt {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        opacity: 0.85;
    }

    .about-headline {
        font-size: clamp(1.8rem, 3vw, 2.5rem);
        font-weight: 900;
        line-height: 1.15;
        letter-spacing: -0.02em;
        margin-bottom: 20px;
        color: var(--text);
    }

        .about-headline .accent {
            color: var(--primary);
        }

    .about-body {
        color: var(--muted);
        line-height: 1.8;
        margin-bottom: 40px;
    }

    .features-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 36px;
    }

    .feature-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 20px;
        transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
        box-shadow: var(--shadow-sm);
    }

        .feature-card:hover {
            border-color: var(--accent);
            transform: translateY(-3px);
            box-shadow: var(--shadow);
        }

    .feature-icon {
        width: 36px;
        height: 36px;
        background: var(--primary-glow);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        font-size: 1rem;
    }

    .feature-card h3 {
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 6px;
        color: var(--text);
    }

    .feature-card p {
        font-size: 0.8rem;
        color: var(--muted);
        line-height: 1.6;
    }

    /* ─── Workouts ───────────────────────────────────────────────  */
    .workouts-section {
        padding: 100px 0;
        background: var(--surface);
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
    }

    .workouts-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 48px;
        flex-wrap: wrap;
        gap: 20px;
    }

    .workouts-headline {
        font-size: clamp(1.8rem, 3vw, 2.5rem);
        font-weight: 900;
        letter-spacing: -0.02em;
        max-width: 400px;
        line-height: 1.15;
        color: var(--text);
    }

        .workouts-headline .accent {
            color: var(--primary);
        }

    .workout-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
    }

    .workout-card {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        transition: transform 0.35s var(--transition), box-shadow 0.35s;
        box-shadow: var(--shadow-sm);
    }

        .workout-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-lg);
        }

    .workout-img-wrap {
        overflow: hidden;
        height: 240px;
        position: relative;
    }

        .workout-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s var(--transition);
            display: block;
        }

    .workout-card:hover .workout-img-wrap img {
        transform: scale(1.08);
    }

    .workout-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(15,23,42,0.65) 0%, transparent 60%);
        pointer-events: none;
    }

    .workout-tag {
        position: absolute;
        top: 14px;
        left: 14px;
        background: var(--primary);
        color: #fff;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        padding: 4px 12px;
        border-radius: 100px;
    }

    .workout-footer {
        padding: 20px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .workout-title {
        font-size: 0.95rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--text);
    }

    .workout-link {
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--primary);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: gap 0.2s;
    }

        .workout-link:hover {
            gap: 8px;
        }

        .workout-link::after {
            content: '→';
        }

    /* ─── Why Us ─────────────────────────────────────────────────  */
    .why-section {
        padding: 100px 0;
        border-top: 1px solid var(--border);
        background: var(--bg);
    }

    .why-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 80px;
        align-items: center;
    }

    .why-headline {
        font-size: clamp(1.8rem, 3vw, 2.6rem);
        font-weight: 900;
        line-height: 1.1;
        letter-spacing: -0.02em;
        margin-bottom: 20px;
        color: var(--text);
    }

        .why-headline .accent {
            color: var(--primary);
        }

    .why-body {
        color: var(--muted);
        line-height: 1.8;
        margin-bottom: 40px;
    }

    .why-items {
        display: flex;
        flex-direction: column;
    }

    .why-item {
        display: flex;
        gap: 24px;
        align-items: flex-start;
        padding: 28px 0;
        border-bottom: 1px solid var(--border);
        transition: padding-left 0.3s var(--transition);
    }

        .why-item:last-child {
            border-bottom: none;
        }

        .why-item:hover {
            padding-left: 8px;
        }

    .why-num {
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        color: var(--primary);
        padding-top: 4px;
        min-width: 28px;
    }

    .why-item h3 {
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 6px;
        text-transform: capitalize;
        color: var(--text);
    }

    .why-item p {
        font-size: 0.85rem;
        color: var(--muted);
        line-height: 1.7;
    }

    .why-images {
        position: relative;
        height: 500px;
    }

    .why-img {
        position: absolute;
        object-fit: cover;
        border-radius: var(--radius);
        transition: transform 0.4s var(--transition);
    }

    .why-img-1 {
        width: 65%;
        height: 70%;
        top: 0;
        right: 0;
        border-radius: var(--radius) 120px var(--radius) var(--radius);
    }

    .why-img-2 {
        width: 55%;
        height: 50%;
        bottom: 0;
        left: 0;
        border-radius: var(--radius) var(--radius) 120px var(--radius);
        box-shadow: 0 0 0 6px var(--bg);
    }

    .why-images:hover .why-img-1 {
        transform: scale(1.03) rotate(1deg);
    }

    .why-images:hover .why-img-2 {
        transform: scale(1.03) rotate(-1deg);
    }

    .sessions-strip {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-top: 40px;
    }

    .session-chip {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 16px;
        transition: border-color 0.25s, box-shadow 0.25s;
        box-shadow: var(--shadow-sm);
    }

        .session-chip:hover {
            border-color: var(--accent);
            box-shadow: var(--shadow);
        }

    .session-chip-num {
        font-size: 1.5rem;
        font-weight: 800;
        display: block;
        margin-bottom: 4px;
        color: var(--text);
    }

        .session-chip-num.accent {
            color: var(--primary);
        }

    .session-chip-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: var(--muted);
    }

    /* ─── Footer ─────────────────────────────────────────────────  */
    footer {
        border-top: 1px solid var(--border);
        background: var(--surface);
    }

    .footer-grid {
        max-width: 1200px;
        margin: 0 auto;
        padding: 64px 6vw;
        display: grid;
        grid-template-columns: 1.6fr 1fr 1fr 1fr;
        gap: 48px;
    }

    .footer-logo img {
        height: 38px;
        object-fit: contain;
        margin-bottom: 16px;
        display: block;
    }

    .footer-tagline {
        font-size: 0.85rem;
        color: var(--muted);
        line-height: 1.7;
    }

    .footer-col h4 {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 20px;
    }

    .footer-col ul {
        list-style: none;
    }

    .footer-col li {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
        font-size: 0.88rem;
        color: var(--text-secondary);
    }

        .footer-col li img {
            width: 18px;
            height: 18px;
            object-fit: contain;
            filter: invert(0.3);
            opacity: 0.6;
        }

    .footer-col p {
        font-size: 0.88rem;
        color: var(--text-secondary);
        line-height: 1.7;
    }

    .footer-bottom {
        border-top: 1px solid var(--border);
        padding: 20px 6vw;
        display: flex;
        justify-content: space-between;
        font-size: 0.78rem;
        color: var(--muted);
        max-width: 1200px;
        margin: 0 auto;
    }

    /* ─── Responsive ─────────────────────────────────────────────  */
    @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
            animation: none !important;
            transition: none !important;
        }
    }

    @@media (max-width: 900px) {
        .hero {
            grid-template-columns: 1fr;
            padding-top: 48px;
            min-height: auto;
        }

        .hero-image-panel {
            height: 380px;
            margin-top: 40px;
        }

        .hero-img-main {
            width: 100%;
            height: 360px;
            border-radius: 140px 140px 0 0;
        }

        .hero-float-card {
            left: 16px;
            top: 60px;
        }

        .about-grid, .why-grid {
            grid-template-columns: 1fr;
        }

        .about-images, .why-images {
            height: 320px;
        }

        .workout-cards {
            grid-template-columns: 1fr;
        }

        .footer-grid {
