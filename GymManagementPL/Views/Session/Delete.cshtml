@{
    ViewData["Title"] = "Delete Session";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow text-center" style="border-top:4px solid var(--danger);border-radius:12px;">
                <div class="card-body p-5">
                    <i class="bi bi-calendar-x-fill mb-3" style="color:var(--danger);font-size:3.5rem;display:block;"></i>
                    <h3 class="fw-bold mb-1">Delete Session</h3>
                    <p class="text-muted mb-4">Are you sure you want to permanently delete this session?</p>
                    <div class="alert alert-warning text-start mb-4">
                        <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>Warning</strong><br>
                        <small>This cannot be undone. Only completed sessions with no bookings can be deleted.</small>
                    </div>
                    <form asp-action="DeleteConfirmed" asp-route-id="@ViewBag.SessionId" method="post">
                        <div class="d-flex gap-3">
                            <a asp-action="Index" class="btn-outline flex-fill d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-x-lg"></i>Cancel
                            </a>
                            <button type="submit" class="btn-fill flex-fill d-flex align-items-center justify-content-center gap-2"
                                    style="background:var(--danger);border-color:var(--danger);">
                                <i class="bi bi-trash"></i>Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>