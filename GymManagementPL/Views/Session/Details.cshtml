@using GymManagementBLL.ViewModels.SessionViewModels
@model SessionDetailsViewModel
@{
    ViewData["Title"] = "Session Details";
    var headerBg = Model.Status == "OnGoing" ? "bg-success" : Model.Status == "UpComing" ? "bg-primary-color" : "bg-secondary";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card border-0 shadow mb-4">
                <div class="card-header text-white text-center py-5 @headerBg">
                    <i class="bi bi-calendar-event" style="font-size:2.8rem;display:block;margin-bottom:12px;"></i>
                    <h2 class="mb-2 fw-bold">@Model.CategoryName</h2>
                    <span class="badge rounded-pill" style="background:rgba(255,255,255,.2);padding:6px 18px;font-size:.85rem;">@Model.Status</span>
                </div>
                <div class="card-body p-4">
                    <div class="p-3 rounded mb-4" style="background:var(--surface);border:1px solid var(--border);">
                        <small class="text-muted d-block mb-1" style="font-size:.73rem;text-transform:uppercase;letter-spacing:.5px;">Description</small>
                        <p class="mb-0">@Model.Description</p>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="p-3 rounded h-100" style="background:var(--surface);border:1px solid var(--border);">
                                <small class="text-muted d-block mb-1" style="font-size:.73rem;text-transform:uppercase;letter-spacing:.5px;">Trainer</small>
                                <strong><i class="bi bi-person-circle me-1" style="color:var(--accent);"></i>@Model.TrainerName</strong>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 rounded h-100" style="background:var(--surface);border:1px solid var(--border);">
                                <small class="text-muted d-block mb-1" style="font-size:.73rem;text-transform:uppercase;letter-spacing:.5px;">Date</small>
                                <strong><i class="bi bi-calendar3 me-1" style="color:var(--accent);"></i>@Model.DisplayDate</strong>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 rounded h-100" style="background:var(--surface);border:1px solid var(--border);">
                                <small class="text-muted d-block mb-1" style="font-size:.73rem;text-transform:uppercase;letter-spacing:.5px;">Time</small>
                                <strong><i class="bi bi-clock me-1" style="color:var(--accent);"></i>@Model.DisplayTimeRange</strong>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 rounded h-100" style="background:var(--surface);border:1px solid var(--border);">
                                <small class="text-muted d-block mb-1" style="font-size:.73rem;text-transform:uppercase;letter-spacing:.5px;">Duration</small>
                                <strong><i class="bi bi-hourglass-split me-1" style="color:var(--accent);"></i>@Model.Duration</strong>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 rounded h-100" style="background:var(--surface);border:1px solid var(--border);">
                                <small class="text-muted d-block mb-1" style="font-size:.73rem;text-transform:uppercase;letter-spacing:.5px;">Capacity</small>
                                <strong><i class="bi bi-people me-1" style="color:var(--accent);"></i>@Model.AvailableSlots / @Model.Capacity slots</strong>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 rounded h-100" style="background:var(--surface);border:1px solid var(--border);">
                                <small class="text-muted d-block mb-1" style="font-size:.73rem;text-transform:uppercase;letter-spacing:.5px;">Attendance</small>
                                <strong><i class="bi bi-check2-circle me-1" style="color:var(--success);"></i>@Model.AttendedCount / @Model.BookedCount attended</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow mb-4">
                <div class="card-header" style="background:var(--surface);border-bottom:1px solid var(--border);">
                    <h5 class="mb-0 fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-people-fill" style="color:var(--primary);"></i>
                        Assigned Members
                        <span class="badge rounded-pill ms-1" style="background:var(--accent-light);color:var(--primary);font-size:.8rem;">@Model.BookedCount</span>
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.AssignedMembers.Any())
                    {
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th style="width:48px;">#</th>
                                        <th>Member</th>
                                        <th>Booked At</th>
                                        <th class="text-center">Attendance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int row = 1; }
                                    @foreach (var member in Model.AssignedMembers)
                                    {
                                        <tr>
                                            <td class="text-muted" style="font-size:.8rem;">@row++</td>
                                            <td><strong>@member.MemberName</strong></td>
                                            <td class="text-muted" style="font-size:.85rem;">@member.BookedAt.ToString("MMM dd, yyyy – hh:mm tt")</td>
                                            <td class="text-center">
                                                @if (member.IsAttended)
                                                {
                                                    <span class="badge rounded-pill" style="background:#ecfdf5;color:#065f46;font-weight:700;padding:5px 12px;">
                                                        <i class="bi bi-check-lg me-1"></i>Attended
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge rounded-pill" style="background:#f3f4f6;color:#6b7280;font-weight:700;padding:5px 12px;">
                                                        <i class="bi bi-x-lg me-1"></i>Absent
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-person-slash" style="font-size:2rem;"></i>
                            <p class="mt-2 mb-0">No members assigned yet.</p>
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-controller="Schedule" asp-action="Index" class="btn-outline d-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left"></i>Back to Schedule
                </a>
                @if (Model.Status == "UpComing")
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-fill d-flex align-items-center gap-2">
                        <i class="bi bi-pencil"></i>Edit Session
                    </a>
                }
            </div>
        </div>
    </div>
</div>