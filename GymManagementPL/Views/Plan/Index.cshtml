@model IEnumerable<PlanViewModel>
@{
    ViewData["Title"] = "Plans";
}

@if (TempData["SuccessMessage"] is not null)
{
    <div id="Alert" class="alert alert-success alert-dismissible fade show mt-3">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] is not null)
{
    <div id="Alert" class="alert alert-danger alert-dismissible fade show mt-3">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container">
    <div class="page-header">
        <div>
            <h2><i class="bi bi-card-list me-2"></i>Membership Plans</h2>
            <p>Manage your gym membership packages</p>
        </div>
    </div>

    @if (Model is not null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var plan in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 plan-card border-0 shadow-sm">
                        <div class="card-header text-white text-center py-4 @(plan.IsActive ? "bg-primary-color" : "bg-secondary")">
                            <h4 class="mb-0 fw-bold">@plan.Name</h4>
                            <span class="badge mt-2 rounded-pill" style="background:rgba(255,255,255,.2);font-size:.75rem;padding:4px 12px;">
                                @(plan.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>
                        <div class="card-body d-flex flex-column p-4">
                            <div class="text-center p-3 rounded mb-3" style="background:var(--surface);border:1px solid var(--border);">
                                <div style="font-size:2.4rem;font-weight:800;color:var(--primary);line-height:1;">@plan.Price.ToString("N0")</div>
                                <div style="font-size:.85rem;color:var(--text-muted);margin-top:4px;">EGP / plan</div>
                            </div>
                            <div class="mb-3 flex-grow-1">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="bi bi-calendar-check" style="color:var(--primary);"></i>
                                    <span style="font-size:.87rem;font-weight:600;">@plan.DurationDays days</span>
                                </div>
                                <div class="d-flex align-items-start gap-2">
                                    <i class="bi bi-file-text" style="color:var(--primary);margin-top:2px;flex-shrink:0;"></i>
                                    <p class="mb-0" style="font-size:.85rem;color:var(--text-muted);">@plan.Description</p>
                                </div>
                            </div>
                            <div class="d-grid gap-2 mt-auto">
                                <a asp-action="Details" asp-route-id="@plan.Id"
                                   class="btn-outline btn-sm d-flex align-items-center justify-content-center gap-2">
                                    <i class="bi bi-eye"></i>View Details
                                </a>
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@plan.Id"
                                       class="btn-outline btn-sm flex-fill d-flex align-items-center justify-content-center gap-1">
                                        <i class="bi bi-pencil"></i>Edit
                                    </a>
                                    <form asp-action="Activate" asp-route-id="@plan.Id" method="post" class="flex-fill">
                                        <button type="submit" class="btn-sm w-100 d-flex align-items-center justify-content-center gap-1"
                                                style="border-radius:6px;border:2px solid;font-weight:600;padding:6px 14px;cursor:pointer;background:transparent;
                                                               border-color:@(plan.IsActive ? "var(--danger)" : "var(--success)");
                                                               color:@(plan.IsActive ? "var(--danger)" : "var(--success)");">
                                            @if (plan.IsActive)
                                            {
                                                <i class="bi bi-x-circle"></i>
                                    
                                                <span>Deactivate</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-check-circle"></i>
                                    
                                                <span>Activate</span>
                                            }
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <h4>No Plans Available</h4>
            <p>Create your first membership plan to get started.</p>
        </div>
    }
</div>

@section Scripts {
    <partial name="_AlertTimeOut" />
}