@{
    Layout = null;
    ViewData["Title"] = "Access Denied";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Access Denied – FitFlow</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+Thambi+2:wght@400..800&family=Rubik:wght@300..700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        :root {
            --primary: #0a0f6b;
            --accent: #4361ee;
            --surface: #f7f8ff;
            --border: #e4e7f5;
            --text: #1a1b2e;
            --muted: #6b7280;
            --danger: #ef4444;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Rubik',sans-serif;
            background: var(--surface);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            background-image: radial-gradient(circle at 20% 50%,rgba(67,97,238,.07) 0%,transparent 50%),radial-gradient(circle at 80% 20%,rgba(10,15,107,.05) 0%,transparent 40%);
        }

        .card {
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(10,15,107,.12);
            overflow: hidden;
            max-width: 800px;
            width: 100%;
            display: grid;
            grid-template-columns: 1fr auto;
        }

        .content {
            padding: 60px 56px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .badge-403 {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #fef2f2;
            color: var(--danger);
            border-radius: 100px;
            padding: 6px 16px;
            font-size: .8rem;
            font-weight: 700;
            letter-spacing: .4px;
            width: fit-content;
        }

        h1 {
            font-family: 'Baloo Thambi 2',system-ui;
            font-size: 3rem;
            font-weight: 800;
            line-height: 1.1;
            color: var(--text);
        }

            h1 span {
                color: var(--accent);
            }

        p.desc {
            font-size: .95rem;
            color: var(--muted);
            line-height: 1.7;
            max-width: 340px;
        }

        .error-code {
            background: var(--surface);
            border: 1px solid var(--border);
            border-left: 4px solid var(--danger);
            padding: 10px 16px;
            border-radius: 6px;
            font-family: 'Courier New',monospace;
            font-size: .82rem;
            color: var(--text);
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 26px;
            border-radius: 8px;
            font-size: .9rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            border: 2px solid var(--primary);
            transition: all .2s;
        }

        .btn-primary {
            background: var(--primary);
            color: #fff;
        }

            .btn-primary:hover {
                background: #1e2a9e;
                transform: translateY(-1px);
                box-shadow: 0 4px 14px rgba(10,15,107,.3);
            }

        .illustration {
            background: linear-gradient(145deg,var(--primary) 0%,var(--accent) 100%);
            padding: 48px 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 16px;
            color: #fff;
            min-width: 220px;
        }

        .lock-emoji {
            font-size: 5rem;
            animation: float 3s ease-in-out infinite;
        }

        .lock-text {
            font-size: .75rem;
            font-family: 'Baloo Thambi 2',system-ui;
            font-weight: 700;
            letter-spacing: .8px;
            opacity: .85;
            text-transform: uppercase;
        }

        @@keyframes float {
            0%, 100% {
                transform: translateY(0)
            }

            50% {
                transform: translateY(-8px)
            }
        }

        @@media(max-width:600px) {
            .card {
                grid-template-columns: 1fr
            }

            .illustration {
                display: none
            }

            .content {
                padding: 40px 28px
            }

            h1 {
                font-size: 2rem
            }
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="content">
            <div class="badge-403"><i class="bi bi-shield-x"></i>403 Forbidden</div>
            <h1>Access <span>Denied</span></h1>
            <p class="desc">You don't have permission to view this page. Your current role doesn't grant access to this section.</p>
            <div class="error-code">Error: 403 – Forbidden Access</div>
            <p class="desc" style="font-size:.87rem;">If you think this is a mistake, contact your system administrator.</p>
            <div>
                <a asp-action="Index" asp-controller="Home" class="btn btn-primary">
                    <i class="bi bi-house"></i>Return to Home
                </a>
            </div>
        </div>
        <div class="illustration">
            <div class="lock-emoji">🔒</div>
            <div class="lock-text">No Access</div>
        </div>
    </div>
</body>
</html>