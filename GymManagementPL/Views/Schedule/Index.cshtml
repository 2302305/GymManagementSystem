@using GymManagementBLL.ViewModels.ScheduleViewModels
@using GymManagementBLL.ViewModels.SessionViewModels
@model ScheduleIndexViewModel
@{
    ViewData["Title"] = "Session Schedule";
}

<div class="container">
    <div class="page-header">
        <div>
            <h2><i class="bi bi-clock-history me-2"></i>Session Schedule</h2>
            <p>Overview of all gym training sessions</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <span class="badge rounded-pill d-flex align-items-center gap-1"
                  style="background:#ecfdf5;color:#065f46;font-weight:700;padding:8px 16px;font-size:.82rem;">
                <i class="bi bi-circle-fill" style="font-size:.5rem;"></i>Ongoing: @Model.TotalOngoing
            </span>
            <span class="badge rounded-pill d-flex align-items-center gap-1"
                  style="background:var(--accent-light);color:var(--primary);font-weight:700;padding:8px 16px;font-size:.82rem;">
                <i class="bi bi-clock" style="font-size:.75rem;"></i>Upcoming: @Model.TotalUpcoming
            </span>
            <span class="badge rounded-pill d-flex align-items-center gap-1"
                  style="background:#f3f4f6;color:#374151;font-weight:700;padding:8px 16px;font-size:.82rem;">
                <i class="bi bi-check-circle" style="font-size:.75rem;"></i>Completed: @Model.TotalCompleted
            </span>
        </div>
    </div>

    @if (!Model.HasAnySessions)
    {
        <div class="empty-state">
            <i class="bi bi-calendar-x"></i>
            <h4>No Sessions Scheduled</h4>
            <p>Add sessions to see them appear here.</p>
            <a asp-controller="Session" asp-action="Create" class="btn-fill mt-3 d-inline-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i>Add Session
            </a>
        </div>
    }
    else
    {
        @if (Model.Ongoing.Any())
        {
            <div class="mb-5">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <span class="badge rounded-pill" style="background:#ecfdf5;color:#065f46;padding:6px 14px;">
                        <i class="bi bi-circle-fill me-1" style="font-size:.5rem;"></i>Live Now
                    </span>
                    Ongoing Sessions
                </h5>
                @await Html.PartialAsync("_SessionTable", new Tuple<IEnumerable<SessionViewModel>, string>(Model.Ongoing, "success"))
            </div>
        }
        @if (Model.Upcoming.Any())
        {
            <div class="mb-5">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <span class="badge rounded-pill" style="background:var(--accent-light);color:var(--primary);padding:6px 14px;">
                        <i class="bi bi-clock me-1"></i>Upcoming
                    </span>
                    Upcoming Sessions
                </h5>
                @await Html.PartialAsync("_SessionTable", new Tuple<IEnumerable<SessionViewModel>, string>(Model.Upcoming, "primary"))
            </div>
        }
        @if (Model.Completed.Any())
        {
            <div class="mb-5">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <span class="badge rounded-pill" style="background:#f3f4f6;color:#374151;padding:6px 14px;">
                        <i class="bi bi-check-circle me-1"></i>Completed
                    </span>
                    Completed Sessions
                </h5>
                @await Html.PartialAsync("_SessionTable", new Tuple<IEnumerable<SessionViewModel>, string>(Model.Completed, "secondary"))
            </div>
        }
    }
</div>