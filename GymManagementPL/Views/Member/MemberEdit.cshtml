@model UpdateMemberViewModel
@{
    ViewData["Title"] = "Edit Member";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow overflow-hidden">
                <div style="height:90px;background:linear-gradient(135deg,var(--primary) 0%,var(--primary-mid) 100%);"></div>
                <div class="text-center" style="margin-top:-50px;position:relative;z-index:2;">
                    <img src="~/images/Members/@Model.Photo" alt="@Model.Name"
                         style="width:100px;height:100px;object-fit:cover;border-radius:50%;border:4px solid #fff;box-shadow:0 4px 16px rgba(10,15,107,.2);" />
                </div>
                <div class="card-body text-center pt-2">
                    <h2 class="mb-0" style="color:var(--primary);">@Model.Name</h2>
                    <p class="text-muted mb-4" style="font-size:.85rem;">Editing profile</p>
                </div>
                <div class="card-body pt-0">
                    <form asp-action="MemberEdit" method="post">
                        <input readonly hidden asp-for="Photo" />
                        <input readonly hidden asp-for="Name" />
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Email</label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phone</label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Building Number</label>
                                <input asp-for="BuildingNumber" class="form-control" />
                                <span asp-validation-for="BuildingNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">City</label>
                                <input asp-for="City" class="form-control" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Street</label>
                                <input asp-for="Street" class="form-control" />
                                <span asp-validation-for="Street" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="d-flex gap-3 mt-4 pt-3" style="border-top:1px solid var(--border);">
                            <a asp-controller="Member" asp-action="Index"
                               class="btn-outline flex-fill text-center d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-arrow-left"></i>Back
                            </a>
                            <button type="submit" class="btn-fill flex-fill d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-check-lg"></i>Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}