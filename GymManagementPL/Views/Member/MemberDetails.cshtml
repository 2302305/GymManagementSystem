@model MemberViewModel
@{
    ViewData["Title"] = "Member Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow overflow-hidden">
                <div style="height:100px;background:linear-gradient(135deg,var(--primary) 0%,var(--primary-mid) 100%);"></div>
                <div class="text-center" style="margin-top:-55px;position:relative;z-index:2;">
                    @if (string.IsNullOrEmpty(Model.Photo))
                    {
                        <img src="~/Images/about p2.jpg" alt="@Model.Name"
                             style="width:110px;height:110px;object-fit:cover;border-radius:50%;border:4px solid #fff;box-shadow:0 4px 16px rgba(10,15,107,.2);" />
                    }
                    else
                    {
                        <img src="~/Images/Members/@Model.Photo" alt="@Model.Name"
                             style="width:110px;height:110px;object-fit:cover;border-radius:50%;border:4px solid #fff;box-shadow:0 4px 16px rgba(10,15,107,.2);" />
                    }
                </div>
                <div class="card-body text-center pt-2 pb-0">
                    <h2 class="mb-1" style="color:var(--primary);">@Model.Name</h2>
                    <span class="badge rounded-pill mb-3"
                          style="background:var(--accent-light);color:var(--primary);font-weight:600;padding:6px 16px;font-size:.85rem;">
                        @(Model.PlanName ?? "No Active Plan")
                    </span>
                </div>
                <div class="card-body pt-0">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="p-3 rounded" style="background:var(--surface);border:1px solid var(--border);">
                                <small class="text-muted d-block mb-1" style="font-size:.73rem;text-transform:uppercase;letter-spacing:.5px;">Email</small>
                                <strong><i class="bi bi-envelope me-2" style="color:var(--accent);"></i>@Model.Email</strong>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="p-3 rounded" style="background:var(--surface);border:1px solid var(--border);">
                                <small class="text-muted d-block mb-1" style="font-size:.73rem;text-transform:uppercase;letter-spacing:.5px;">Phone</small>
                                <strong><i class="bi bi-telephone me-2" style="color:var(--accent);"></i>@Model.Phone</strong>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 rounded" style="background:var(--surface);border:1px solid var(--border);">
                                <small class="text-muted d-block mb-1" style="font-size:.73rem;text-transform:uppercase;letter-spacing:.5px;">Gender</small>
                                <strong>@Model.Gender</strong>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 rounded" style="background:var(--surface);border:1px solid var(--border);">
                                <small class="text-muted d-block mb-1" style="font-size:.73rem;text-transform:uppercase;letter-spacing:.5px;">Date of Birth</small>
                                <strong>@Model.DateOfBirth</strong>
                            </div>
                        </div>
                        @if (Model.PlanName is not null)
                        {
                            <div class="col-6">
                                <div class="p-3 rounded" style="background:var(--surface);border:1px solid var(--border);">
                                    <small class="text-muted d-block mb-1" style="font-size:.73rem;text-transform:uppercase;letter-spacing:.5px;">Membership Start</small>
                                    <strong>@Model.StartDate</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 rounded" style="background:var(--surface);border:1px solid var(--border);">
                                    <small class="text-muted d-block mb-1" style="font-size:.73rem;text-transform:uppercase;letter-spacing:.5px;">Membership End</small>
                                    <strong>@Model.EndDate</strong>
                                </div>
                            </div>
                        }
                        <div class="col-12">
                            <div class="p-3 rounded" style="background:var(--surface);border:1px solid var(--border);">
                                <small class="text-muted d-block mb-1" style="font-size:.73rem;text-transform:uppercase;letter-spacing:.5px;">Address</small>
                                <strong>@(Model.Address ?? "Address not provided")</strong>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <a asp-controller="Member" asp-action="Index"
                       class="btn-outline d-flex align-items-center gap-2 justify-content-center">
                        <i class="bi bi-arrow-left"></i>Back to Members
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>