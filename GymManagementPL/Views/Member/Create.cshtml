@using GymManagementDAL.Entities.Enums
@model CreateMemberviewModel
@{
    ViewData["Title"] = "Add Member";
}

<div class="container mt-4">
    <div class="page-header">
        <div>
            <h2><i class="bi bi-person-plus me-2"></i>Add Member</h2>
            <p>Register a new gym member</p>
        </div>
    </div>

    @Html.ValidationMessage("DataInvalid", new { @class = "text-danger" })

    <form asp-action="CreateMember" method="post" enctype="multipart/form-data">
        <ul class="nav nav-tabs mb-4" id="addMemberTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="member-tab" data-bs-toggle="tab"
                        data-bs-target="#member-info" type="button" role="tab">
                    <i class="bi bi-person me-2"></i>Member Info
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="health-tab" data-bs-toggle="tab"
                        data-bs-target="#health-info" type="button" role="tab">
                    <i class="bi bi-heart-pulse me-2"></i>Health Data
                </button>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="member-info" role="tabpanel">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4">
                        <div class="section-header mb-4">
                            <h5><i class="bi bi-person-circle me-2"></i>Personal Information</h5>
                            <hr>
                        </div>
                        <div class="row g-4">
                            <div class="col-12">
                                <label asp-for="PhotoFile" class="form-label">
                                    Profile Photo <span class="text-danger">*</span>
                                </label>
                                <div class="d-flex align-items-center gap-4 flex-wrap">
                                    <img id="photoPreview" src="#" alt="Preview"
                                         style="width:80px;height:80px;object-fit:cover;border-radius:50%;border:3px solid var(--border);display:none;" />
                                    <div class="flex-grow-1">
                                        <input asp-for="PhotoFile" type="file" class="form-control" accept="image/*" id="photoInput" required />
                                        <small class="text-muted" style="font-size:.78rem;">Max 5 MB · JPG, PNG, JPEG</small>
                                        <span asp-validation-for="PhotoFile" class="text-danger d-block small"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label">Full Name <span class="text-danger">*</span></label>
                                <input asp-for="Name" type="text" class="form-control" placeholder="Enter full name" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label">Phone <span class="text-danger">*</span></label>
                                <input asp-for="Phone" type="tel" class="form-control" placeholder="+20 xxx xxx xxxx" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                                <input asp-for="DateOfBirth" type="date" class="form-control" />
                                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Gender" class="form-label">Gender</label>
                                <select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="form-select">
                                    <option value="">— Select Gender —</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="section-header mb-4">
                            <h5><i class="bi bi-geo-alt me-2"></i>Address Information</h5>
                            <hr>
                        </div>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="BuildingNumber" class="form-label">Building Number</label>
                                <input asp-for="BuildingNumber" type="text" class="form-control" />
                                <span asp-validation-for="BuildingNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Street" class="form-label">Street</label>
                                <input asp-for="Street" type="text" class="form-control" />
                                <span asp-validation-for="Street" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="City" class="form-label">City</label>
                                <input asp-for="City" type="text" class="form-control" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="health-info" role="tabpanel">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="section-header mb-4">
                            <h5><i class="bi bi-heart-pulse me-2"></i>Health Information</h5>
                            <hr>
                        </div>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="HealthRecordViewModel.Hieght" class="form-label">Height (cm)</label>
                                <input asp-for="HealthRecordViewModel.Hieght" type="number" class="form-control" placeholder="175" />
                                <span asp-validation-for="HealthRecordViewModel.Hieght" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="HealthRecordViewModel.Weight" class="form-label">Weight (kg)</label>
                                <input asp-for="HealthRecordViewModel.Weight" type="number" class="form-control" placeholder="75" />
                                <span asp-validation-for="HealthRecordViewModel.Weight" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="HealthRecordViewModel.BloodType" class="form-label">Blood Type</label>
                                <select asp-for="HealthRecordViewModel.BloodType" class="form-select">
                                    <option value="">— Select Blood Type —</option>
                                    <option value="1">A+</option>
                                    <option value="2">A-</option>
                                    <option value="3">B+</option>
                                    <option value="4">B-</option>
                                    <option value="5">AB+</option>
                                    <option value="6">AB-</option>
                                    <option value="7">O+</option>
                                    <option value="8">O-</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="HealthRecordViewModel.Note" class="form-label">Notes</label>
                                <input asp-for="HealthRecordViewModel.Note" type="text" class="form-control"
                                       placeholder="Any medical notes or conditions" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3 mt-4">
            <a asp-controller="Member" asp-action="Index" class="btn-outline d-flex align-items-center gap-2">
                <i class="bi bi-arrow-left"></i>Back to List
            </a>
            <button type="submit" class="btn-fill d-flex align-items-center gap-2">
                <i class="bi bi-plus-circle"></i>Add Member
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('photoInput').addEventListener('change', function (e) {
            var file = e.target.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    var preview = document.getElementById('photoPreview');
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
}