@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="../Images/icon.svg" type="image/x-icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+Thambi+2:wght@400..800&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" />
    <title>FitFlow Gym | @ViewData["Title"]</title>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/Images/logo.jpg" alt="FitFlow Logo" style="height:38px;" />
                </a>
                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i>Home
                            </a>
                        </li>
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Member" ? "active" : "")"
                                   asp-controller="Member" asp-action="Index">
                                    <i class="bi bi-people me-1"></i>Members
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Trainer" ? "active" : "")"
                                   asp-controller="Trainer" asp-action="Index">
                                    <i class="bi bi-person-badge me-1"></i>Trainers
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Session" ? "active" : "")"
                               asp-controller="Session" asp-action="Index">
                                <i class="bi bi-calendar-event me-1"></i>Sessions
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Plan" ? "active" : "")"
                               asp-controller="Plan" asp-action="Index">
                                <i class="bi bi-card-list me-1"></i>Plans
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Membership" ? "active" : "")"
                               asp-controller="Membership" asp-action="Index">
                                <i class="bi bi-award me-1"></i>Memberships
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Schedule" ? "active" : "")"
                               asp-controller="Schedule" asp-action="Index">
                                <i class="bi bi-clock-history me-1"></i>Schedule
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center">
                        <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline" id="logout-form">
                            @Html.AntiForgeryToken()
                            <button type="button" data-bs-toggle="modal" data-bs-target="#logoutModal"
                                    class="btn btn-outline-danger btn-sm d-flex align-items-center gap-2 rounded-pill px-3"
                                    style="border-width:2px;font-weight:600;font-size:.85rem;">
                                <i class="bi bi-box-arrow-right"></i><span>Logout</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>

        <div class="modal fade" id="logoutModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
                <div class="modal-content">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold">
                            <i class="bi bi-box-arrow-right text-danger me-2"></i>Confirm Logout
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body pt-2 pb-4 text-center">
                        <div style="font-size:3rem;margin-bottom:12px;">👋</div>
                        <p class="mb-0" style="color:#6b7280;">Are you sure you want to sign out of your account?</p>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-4" data-bs-dismiss="modal">Stay</button>
                        <button type="button" class="btn btn-danger btn-sm rounded-pill px-4"
                                onclick="document.getElementById('logout-form').submit()">
                            <i class="bi bi-box-arrow-right me-1"></i>Sign Out
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="container py-2">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>